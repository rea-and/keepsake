# Keepsake Server Configuration
PORT=3000
NODE_ENV=production

# Generate a secret with: openssl rand -hex 32
# Configure the same token in each client. Required; minimum 32 characters.
KEEPSAKE_API_TOKEN=

# Google OAuth 2.0 Credentials (Get these from https://console.cloud.google.com/)
# Enable Google Drive API in your Google Cloud Project.
# Add Authorized Redirect URI: http://your-server-domain:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Allowed browser origins, comma-separated. Include extension origins if used.
# CORS controls browser access and does not authenticate API requests.
CORS_ORIGIN=*
