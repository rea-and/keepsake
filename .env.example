# Keepsake Server Configuration
PORT=3000
NODE_ENV=production

# Google accounts allowed to sign in (comma-separated). Required.
# Clients sign in with Google and the server issues each device its own session
# token, so there is no secret to copy between the server and your clients.
# Removing an address here ends that account's sessions on the next restart.
KEEPSAKE_ALLOWED_EMAILS=you@example.com

# Optional: a static token (minimum 32 characters, `openssl rand -hex 32`) for
# scripts that cannot sign in with Google. Normal clients do not need it.
# KEEPSAKE_API_TOKEN=

# Google OAuth 2.0 Credentials (Get these from https://console.cloud.google.com/)
# Enable Google Drive API in your Google Cloud Project.
# Add Authorized Redirect URI: http://your-server-domain:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cross-origin browser access is off by default: the web app is served by this server, and
# the extension and Android app do not need CORS. Only set this if a page on another origin
# must call the API (comma-separated origins, or * for any). Requests still need a session.
# CORS_ORIGIN=

# Docker only: with the optional Caddy profile, the domain Caddy gets a certificate for.
# KEEPSAKE_DOMAIN=keepsake.yourdomain.com
