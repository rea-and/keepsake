{
  "name": "keepsake-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Keepsake - Self-hosted, Google Drive-synced bookmark manager (Raindrop.io alternative)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm --workspace=@keepsake/server run dev",
    "dev:web": "npm --workspace=@keepsake/web run dev",
    "build:web": "npm --workspace=@keepsake/web run build",
    "build:server": "npm --workspace=@keepsake/server run build",
    "build:extension": "npm --workspace=@keepsake/extension run build"
  },
  "keywords": [
    "bookmarks",
    "raindrop",
    "google-drive",
    "self-hosted",
    "android",
    "chrome-extension",
    "firefox-extension"
  ],
  "author": "Keepsake",
  "license": "MIT"
}
